# 한국투자증권 OPEN API — https://apiportal.koreainvestment.com/
# 기본은 /kis-key로 ~/.pi/agent/kis-keys.json에 저장 (권장).
# 아래 env 변수는 키 파일이 없을 때의 fallback입니다.

KIS_APP_KEY=
KIS_APP_SECRET=

KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

KIS_HTS_ID=
KIS_ACCT_STOCK=
# 계좌 상품코드 (보통 01, "12345678-01" 형식으로 넣으면 자동 분리되므로 생략 가능)
KIS_ACCT_STOCK_PRDT_CD=
KIS_ACCT_FUTURE=
KIS_PAPER_STOCK=
KIS_PAPER_STOCK_PRDT_CD=
KIS_PAPER_FUTURE=

# 시크릿 저장소 강제 지정 (기본: OS 키체인, SSH/헤드리스에선 자동 file)
# KIS_SECRET_STORE=file     # 헤드리스/컨테이너/SSH
# KIS_SECRET_STORE=keyring  # 키체인 강제

# API 호출 최소 간격(ms) — 전역 스로틀 (기본 300, 주문 600). 0이면 해제.
# KIS_RATE_LIMIT_MS=300

# 토스증권 Open API 키 (개발자센터 발급 client_id/client_secret) — /kis-key에서 등록 가능
# TOSS_CLIENT_ID=
# TOSS_CLIENT_SECRET=

# 토스 레이트리밋 배율 (기본 1.0 — 그룹별 공식 한도 기준, 0이면 해제)
# TOSS_RATE_LIMIT_MULTIPLIER=1.0
