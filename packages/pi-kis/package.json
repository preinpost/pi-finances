{
  "name": "pi-kis",
  "version": "0.4.0",
  "description": "Korea Investment (KIS) OPEN API direct REST client for pi — 공식 포털 전체 API 규격(338개) 기반 국내/해외 주식 시세·차트·주문·리서치·파생 (v2 키 체계, hashkey 자동, tr_cont 연속조회). 토스증권은 pi-toss 패키지 (v0.3.0부터 분리).",
  "type": "module",
  "license": "MIT",
  "author": "minsoo.lee <preinpost@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preinpost/pi-finances.git"
  },
  "bugs": {
    "url": "https://github.com/preinpost/pi-finances/issues"
  },
  "homepage": "https://github.com/preinpost/pi-finances#readme",
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "kis",
    "korea-investment",
    "한국투자증권",
    "stock",
    "trading",
    "market-data"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/pi-finance-core/skills"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "configs",
    "skills",
    "scripts",
    "README.md",
    ".env.example"
  ],
  "dependencies": {
    "pi-finance-core": "workspace:*",
    "@napi-rs/keyring": "^1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "bundledDependencies": [
    "pi-finance-core"
  ]
}
