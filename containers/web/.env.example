# AlphaFolio 로컬 개발용
#   cp .env.example .env
#   npm run dev          → http://localhost:5173
# 이미 export된 셸 변수가 있으면 그쪽이 우선한다.

# ── 비밀번호 게이트 ──────────────────────────────────────────────
PI_WEB_USER=pi
PI_WEB_PASSWORD=change-me
# PI_WEB_AUTH=0

# ── 서버 (기본값이면 비워 둬도 됨) ───────────────────────────────
# PORT=3141
# HOST=127.0.0.1
# PI_WEB_CWD=
# PI_WEB_DEV_PORT=3141

# ── 기본 모델 (선택) ────────────────────────────────────────────
# PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash
# PI_DEFAULT_THINKING=max

# ── LLM 키 (쓰는 프로바이더만) ──────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# ── 금융 데이터 키 (선택) ───────────────────────────────────────
# KIS_APP_KEY=
# KIS_APP_SECRET=
# TOSS_CLIENT_ID=
# TOSS_CLIENT_SECRET=
# TWELVE_API_KEY=
# FINNHUB_API_KEY=
# COINGECKO_API_KEY=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_ENV=live
# NCP_APIGW_API_KEY_ID=
# NCP_APIGW_API_KEY=
# NAVER_NEWS_API_MODE=hub
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
