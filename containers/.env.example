# ── pi 금융분석 에이전트 — 환경 변수 예제 ─────────────────────────────
# 이 파일을 .env 로 복사하고 값을 채우세요:
#   cp .env.example .env
# 키는 컨테이너 런타임에만 주입되며, 이미지에 bake되지 않고
# 컨테이너가 종료되면 함께 소멸합니다 (에페메럴 모델 — 설계 §8).

# ── LLM 프로바이더 (필수) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 한국투자증권 OPEN API (선택 — https://apiportal.koreainvestment.com) ─
# 실전투자
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 (선택)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# ── 토스증권 OPEN API (선택) ─────────────────────────────────────────
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ── 무료 시장 데이터 (선택) ───────────────────────────────────────────
TWELVE_API_KEY=          # https://twelvedata.com  (전 세계 시세·차트·환율)
FINNHUB_API_KEY=         # https://finnhub.io     (미국 주식·뉴스·펀더멘털)
COINGECKO_API_KEY=       # https://www.coingecko.com (암호화폐)
# 네이버 검색 API (NAVER API HUB — 한국 증권 뉴스)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NCP API Gateway를 쓴다면 mode=hub + 아래 2개 (선택)
# NAVER_NEWS_API_MODE=hub
# NCP_APIGW_API_KEY_ID=
# NCP_APIGW_API_KEY=

# ── 웹터미널 basic-auth 토큰 (선택) ──────────────────────────────────
# 미설정 시 컨테이너 시작마다 자동 생성되어 시작 로그에 출력됩니다.
TTYD_TOKEN=
